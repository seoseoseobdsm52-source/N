---
import { getEnv } from '../lib/env'
import podcast from '../assets/podcast.svg'
import twitter from '../assets/twitter.svg'
import github from '../assets/github.svg'
import discord from '../assets/discord.svg'
import telegram from '../assets/telegram.svg'
import mastodon from '../assets/mastodon.svg'
import bluesky from '../assets/bluesky.svg'

const { SITE_URL } = Astro.locals
const { channel } = Astro.props
const currentPath = Astro.url.pathname.replace(/\/$/, '')
const isHomePage = currentPath === '' || currentPath === '/'

const GOOGLE_SEARCH_SITE = getEnv(import.meta.env, Astro, 'GOOGLE_SEARCH_SITE')
const searchAction = GOOGLE_SEARCH_SITE ? 'https://www.google.com/search' : '/search/result'
const hasTagsPage = (getEnv(import.meta.env, Astro, 'TAGS') || '').split(',').filter(Boolean).length > 0

const PODCASRT = getEnv(import.meta.env, Astro, 'PODCASRT')
const TWITTER = getEnv(import.meta.env, Astro, 'TWITTER')
const GITHUB = getEnv(import.meta.env, Astro, 'GITHUB')
const TELEGRAM = getEnv(import.meta.env, Astro, 'TELEGRAM')
const DISCORD = getEnv(import.meta.env, Astro, 'DISCORD')
const MASTODON = getEnv(import.meta.env, Astro, 'MASTODON')
const BLUESKY = getEnv(import.meta.env, Astro, 'BLUESKY')
---

<div id="header">
  {!isHomePage && (
    <a href={SITE_URL} class="back-button" title="返回首页" aria-label="返回首页">
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 4L6 10L12 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  )}

  <div class="header-title">
    <a href={SITE_URL} class="site-title" title={channel?.title}>
      {channel?.title}
    </a>
    {hasTagsPage && (
      <a href={`${SITE_URL}tags`} class="header-label" title="分类">分类</a>
    )}
  </div>

  <div class="header-icons">
    <form class="header-search-form" action={searchAction} method="get">
      {GOOGLE_SEARCH_SITE ? <input type="hidden" name="as_sitesearch" value={GOOGLE_SEARCH_SITE} /> : null}
      <input type="text" name="q" placeholder="搜索..." class="header-search-input" aria-label="搜索" />
      <button type="submit" class="header-search-button" title="搜索" aria-label="搜索">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="7" cy="7" r="4" stroke="currentColor" stroke-width="1.5"/>
          <path d="m10 10 3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </form>

    {PODCASRT && (
      <a href={PODCASRT} target="_blank" title="Podcast" class="social-link" aria-label="Podcast">
        <img {...podcast} alt="" class="social-icon" width="1em" aria-hidden="true" />
      </a>
    )}
    {TWITTER && TWITTER.length > 0 && (
      <a href={`https://twitter.com/${TWITTER}`} title="Twitter" target="_blank" class="social-link" aria-label="Twitter">
        <img {...twitter} alt="" class="social-icon" width="1em" aria-hidden="true" />
      </a>
    )}
    {GITHUB && GITHUB.length > 0 && (
      <a href={`https://github.com/${GITHUB}`} title="GitHub" target="_blank" class="social-link" aria-label="GitHub">
        <img {...github} alt="" class="social-icon" width="1em" aria-hidden="true" />
      </a>
    )}
    {TELEGRAM && TELEGRAM.length > 0 && (
      <a href={`https://t.me/${TELEGRAM}`} title="Telegram" target="_blank" class="social-link" aria-label="Telegram">
        <img {...telegram} alt="" class="social-icon" width="1em" aria-hidden="true" />
      </a>
    )}
    {DISCORD && DISCORD.length > 0 && (
      <a href={DISCORD} title="Discord" target="_blank" class="social-link" aria-label="Discord">
        <img {...discord} alt="" class="social-icon" width="1em" aria-hidden="true" />
      </a>
    )}
    {MASTODON && MASTODON.length > 0 && (
      <a href={`https://${MASTODON}`} title="Mastodon" target="_blank" class="social-link" aria-label="Mastodon">
        <img {...mastodon} alt="" class="social-icon" width="1em" aria-hidden="true" />
      </a>
    )}
    {BLUESKY && BLUESKY.length > 0 && (
      <a href={`https://bsky.app/profile/${BLUESKY}`} title="BlueSky" target="_blank" class="social-link" aria-label="BlueSky">
        <img {...bluesky} alt="" class="social-icon" width="1em" aria-hidden="true" />
      </a>
    )}
  </div>
</div>

{channel?.descriptionHTML && channel?.descriptionHTML.length > 0 && (
  <div class="text-box" id="site-intro" set:html={channel?.descriptionHTML} />
)}

<style>
  /* ── Layout ── */
  #header {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: nowrap;
  }

  .header-title {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex: 1;
    min-width: 0; /* allow text truncation */
  }

  .header-icons {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  /* ── Back button ── */
  .back-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--cell-background-color);
    border: 1px solid var(--border-color);
    color: var(--foreground-color);
    flex-shrink: 0;
    transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.2s;
  }

  .back-button:hover {
    background: rgba(0, 212, 255, 0.1);
    border-color: var(--highlight-color);
    color: var(--highlight-color);
    transform: translateX(-2px);
    text-decoration: none;
  }

  .back-button:active {
    transform: translateX(-2px) scale(0.95);
  }

  /* ── Site title ── */
  .site-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--foreground-color);
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: color 0.2s;
  }

  .site-title:hover {
    color: var(--highlight-color);
    text-decoration: none;
  }

  /* ── 分类 label ── */
  .header-label {
    color: var(--secondary-color);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    transition: color 0.2s;
  }

  .header-label:hover {
    color: var(--highlight-color);
    text-decoration: none;
  }

  /* ── Search form ── */
  .header-search-form {
    display: flex;
    align-items: center;
    gap: 4px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    padding: 5px 8px 5px 12px;
    transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
  }

  .header-search-form:focus-within {
    border-color: var(--highlight-color);
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 0 0 3px rgba(0, 212, 255, 0.1);
  }

  .header-search-input {
    border: none;
    background: transparent;
    color: var(--foreground-color);
    font-size: 13px;
    outline: none;
    width: 110px;
    padding: 2px 0;
    transition: width 0.25s ease;
  }

  .header-search-input:focus {
    width: 150px;
  }

  .header-search-input::placeholder {
    color: var(--secondary-color);
  }

  .header-search-button {
    border: none;
    background: transparent;
    color: var(--highlight-color);
    cursor: pointer;
    padding: 3px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: transform 0.2s;
  }

  .header-search-button:hover {
    transform: scale(1.15);
  }

  .header-search-button:active {
    transform: scale(0.9);
  }

  /* ── Social icons ── */
  .social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.7;
    transition: opacity 0.2s, transform 0.2s;
  }

  .social-link:hover {
    opacity: 1;
    transform: translateY(-1px);
    text-decoration: none;
  }

  .social-icon {
    width: 18px;
    height: 18px;
    display: block;
  }

  /* ── Site intro ── */
  #site-intro {
    color: var(--secondary-color);
    background-color: var(--code-background-color);
    word-break: break-word;
  }

  #site-intro :global(.emoji) {
    font-style: normal;
    margin-right: 2px;
  }

  /* ── Mobile ── */
  @media screen and (max-width: 600px) {
    #header {
      flex-wrap: wrap;
      gap: 10px;
    }

    /* Row 1: back button (if present) + title */
    .back-button {
      width: 32px;
      height: 32px;
      order: 0;
    }

    .header-title {
      order: 1;
      flex: 1;
    }

    /* Row 2: search + social full width */
    .header-icons {
      order: 2;
      width: 100%;
      flex-wrap: nowrap;
      gap: 6px;
    }

    .header-search-form {
      flex: 1;
      min-width: 0;
      padding: 7px 8px 7px 12px;
    }

    .header-search-input {
      width: 100%;
      flex: 1;
      font-size: 14px; /* 避免 iOS 自动缩放 */
    }

    .header-search-input:focus {
      width: 100%;
    }

    .social-link {
      flex-shrink: 0;
    }
  }
</style>
